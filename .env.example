# Anthropic credentials (or use `ant auth login`)
ANTHROPIC_API_KEY=

# Optional tuning
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low          # low keeps phone replies snappy; raise to medium if orders get tricky
AGENT_FAST_MODE=false     # true = Opus 5.5 fast mode (faster output, premium pricing)

# Voice (Twilio ConversationRelay). English speech defaults to Indian English (ElevenLabs
# v4, en-IN); "none" turns a default off. Blank STT settings use Twilio's defaults.
# Check Twilio's ConversationRelay docs for valid providers and voice IDs.
TTS_PROVIDER=             # default ElevenLabs
TTS_VOICE=                # default mCQMfsqGDT6IDkEKR20a-v4_turbo (Indian English)
TTS_LANGUAGE=             # default en-IN: the language the English voice speaks
VOICE_LANGUAGE=           # speech and listening, e.g. en-US
STT_PROVIDER=             # speech-to-text engine, e.g. Google, Deepgram
STT_MODEL=                # speech-to-text model for that provider
GREETING_INTERRUPTIBLE=   # default dtmf: background noise can't cut off the greeting, the keypad can
INTERRUPT_SENSITIVITY=    # default low (Twilio: high): noise is less likely to interrupt the agent
IGNORE_BACKCHANNEL=       # default true: "uh-huh" doesn't interrupt
RELAY_EXTRA_ATTRS=        # JSON of any other ConversationRelay attributes, e.g. {"interruptible": "speech"}

# Twilio: set to enable webhook signature validation (recommended in production)
TWILIO_AUTH_TOKEN=

# Payment links by text (Stripe Checkout + Twilio SMS). Leave STRIPE_SECRET_KEY blank
# to have customers pay at pickup. The pay-first rule is per business, in its settings.
TWILIO_ACCOUNT_SID=
TWILIO_SMS_FROM=          # your Twilio number, e.g. +19135551234
STRIPE_SECRET_KEY=        # sk_test_... to try it out
STRIPE_WEBHOOK_SECRET=    # whsec_... from the Stripe webhook endpoint

# Public base URL Twilio reaches this server on, e.g. https://abc123.ngrok.app
PUBLIC_BASE_URL=
# Analytics (phone_agent/analytics.py). The AI review of each call runs by default.
CALL_REVIEWS=on                      # off to stop reviewing calls
CALL_REVIEW_MODEL=                   # default claude-haiku-5-5
CALL_REVIEWS_PER_BUSINESS_PER_DAY=   # default 300
ANALYTICS_SALT=                      # hashes caller numbers (default: POS_SECRET_KEY)
# PostHog product analytics (browser and server), off unless POSTHOG_KEY is set.
POSTHOG_KEY=                         # PostHog project token (phc_...)
POSTHOG_HOST=                        # default https://us.i.posthog.com
SENTRY_DSN=                          # Sentry project ringcart-server: errors, tracing, logs
SENTRY_ENVIRONMENT=development       # production on Fly (the default when unset)
SENTRY_TRACES_SAMPLE_RATE=           # default 0.1 in production, 1.0 elsewhere
# Languages offered until a business chooses in Settings (default te-IN,hi-IN,ta-IN,kn-IN; empty: none).
DEFAULT_LANGUAGES=
# Each language (TELUGU_, HINDI_, TAMIL_, KANNADA_) can override its setup (phone_agent/languages.py):
# _VOICE (Telugu UgBBYS2sOqTuMpoF3BR0-v4_turbo, others mCQMfsqGDT6IDkEKR20a-v4_turbo), _TTS_PROVIDER,
# _STT_PROVIDER, _SPEECH_MODEL (long), _STT_CODE, _SWITCH_STT (Deepgram:nova-3-general:multi; none).
TELUGU_VOICE=
TELUGU_SPEECH_MODEL=
# Time zone for businesses that haven't set one (default America/Chicago).
DEFAULT_TIMEZONE=
# Product name on the website and dashboards (default Ringcart).
BRAND_NAME=

# Calls one business can have at once (others' callers are unaffected)
MAX_CALLS_PER_BUSINESS=20

# Orders dashboard (/dashboard) and GET /orders. Leave blank to turn both off.
ADMIN_API_TOKEN=

# The SQLite database (businesses, catalogs, orders, calls, accounts)
DATABASE_PATH=data/phone_agent.db

# POS and store integrations (Square, Clover, Shopify). POS_SECRET_KEY turns them on and encrypts the stored
# tokens; generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POS_SECRET_KEY=
SQUARE_APPLICATION_ID=    # from the Square Developer Console (OAuth)
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox   # sandbox or production
SQUARE_API_VERSION=       # optional, default 2025-01-23
CLOVER_APP_ID=            # from the Clover developer dashboard
CLOVER_APP_SECRET=
CLOVER_ENVIRONMENT=sandbox   # sandbox or production (North America)
SHOPIFY_CLIENT_ID=        # Shopify app (Dev Dashboard): redirect URL <PUBLIC_BASE_URL>/pos/shopify/callback
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=      # optional, default 2026-10 (Admin GraphQL API)
POS_ALLOW_TOKENS=         # true: allow `pos connect-token` with a sandbox token, no app needed

# Self-serve sign-up (/ and /manage). Sign in with Google: create a Google Cloud OAuth
# client ("Web application") with redirect URI <PUBLIC_BASE_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPERATOR_EMAILS=          # comma-separated Google emails that see every business and approve go-live requests
ALLOW_PASSWORD_LOGIN=     # true: also show email + password sign-in when Google is configured
IMPORT_MODEL=             # optional, model that reads menu photos (default claude-opus-5-5)

# Limits for self-serve accounts (defaults shown). Going live past the number limits waits
# for an operator to approve it.
MAX_BUSINESSES_PER_ACCOUNT=3
FREE_NUMBERS_PER_ACCOUNT=1     # phone numbers bought automatically per account, in total
NUMBERS_PER_DAY=5              # phone numbers bought automatically per day, across everyone
IMPORTS_PER_BUSINESS_PER_DAY=10
TEST_TURNS_PER_BUSINESS_PER_DAY=60
